/* Clean, modern light theme for the rna_draw desktop editor. */

QMainWindow, QWidget {
    background: #f4f5f7;
    color: #1a1d21;
    font-size: 13px;
}

QToolBar {
    background: #ffffff;
    border-bottom: 1px solid #d7dae0;
    padding: 4px 8px;
    spacing: 6px;
}

QToolBar QToolButton {
    padding: 5px 12px;
    border-radius: 6px;
    background: #eef0f3;
    color: #1a1d21;
}

QToolBar QToolButton:hover {
    background: #1fb6a6;
    color: #ffffff;
}

QLineEdit {
    background: #ffffff;
    border: 1px solid #c8ccd3;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #1fb6a6;
}

QLineEdit:focus {
    border: 1px solid #1fb6a6;
}

QGraphicsView {
    background: #ffffff;
    border: none;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #d7dae0;
}

QStatusBar QLabel {
    padding: 2px 8px;
}
